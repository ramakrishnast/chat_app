# Copy to .env (`make setup` does it). Read by the backend and docker compose.

# --- Your graph ----------------------------------------------------------------------------
# "module:attribute": a StateGraph builder, a compiled graph, or a factory returning one.
GRAPH=agents.example.graph:builder
# Extra import roots, comma-separated, e.g. a separate repo holding your agents.
GRAPH_PYTHONPATH=

# --- Storage -------------------------------------------------------------------------------
# LangGraph checkpoints + the chat list. Empty = in memory (lost on restart).
DATABASE_URL=postgresql://chat:chat@localhost:5433/chat
POSTGRES_USER=chat
POSTGRES_PASSWORD=chat
POSTGRES_DB=chat
POSTGRES_PORT=5433

# --- Models (ids look like "<provider>:<name>") --------------------------------------------
# Used when a chat has no model yet. Empty = first available model.
DEFAULT_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
# Set a key to add that provider's models to the picker.
OPENAI_API_KEY=
OPENAI_MODELS=gpt-5-mini,gpt-5
# For OpenAI-compatible servers (vLLM, LM Studio, proxies).
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=claude-sonnet-5-5,claude-haiku-5-5,claude-opus-5-5
ANTHROPIC_THINKING_BUDGET=4096
# Offline demo model "fake:echo" (no Ollama or key needed).
ENABLE_FAKE_MODEL=false
MODEL_TIMEOUT=300

# --- Server --------------------------------------------------------------------------------
# Origins allowed to call the API (where the frontend is served from).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
